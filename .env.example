# All settings are optional. Values shown are the defaults.
GEO_DATABASE_URL=sqlite:///./data/geo.db
GEO_MAX_UPLOAD_BYTES=52428800
GEO_MAX_UNCOMPRESSED_BYTES=524288000
GEO_MAX_ARCHIVE_MEMBERS=1000
GEO_MAX_COMPRESSION_RATIO=200
GEO_MAX_FEATURES=250000
GEO_DEFAULT_PAGE_SIZE=100
GEO_MAX_PAGE_SIZE=1000
