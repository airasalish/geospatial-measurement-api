# All settings are optional. Values shown are the defaults.
GEO_DATABASE_URL=sqlite:///./data/geo.db
# PostgreSQL/PostGIS: GEO_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db

# Limits
GEO_MAX_UPLOAD_BYTES=52428800
GEO_MAX_UNCOMPRESSED_BYTES=524288000
GEO_MAX_ARCHIVE_MEMBERS=1000
GEO_MAX_COMPRESSION_RATIO=200
GEO_MAX_FEATURES=250000
GEO_MAX_RASTER_UPLOAD_BYTES=524288000
GEO_MAX_RASTER_PIXELS=250000000
GEO_DEFAULT_PAGE_SIZE=100
GEO_MAX_PAGE_SIZE=1000
GEO_MAX_GEOJSON_FEATURES=100000

# Blob storage: local (GEO_STORAGE_DIR) or s3 (AWS S3 or any S3-compatible store)
GEO_STORAGE_BACKEND=local
GEO_STORAGE_DIR=data/blobs
# GEO_S3_BUCKET=traverse
# GEO_S3_ENDPOINT_URL=http://localhost:8333
# GEO_S3_ACCESS_KEY=
# GEO_S3_SECRET_KEY=
# GEO_S3_REGION=us-east-1

# Processing: sync (in the request) or celery (202 + worker)
GEO_TASK_MODE=sync
GEO_REDIS_URL=redis://localhost:6379/0

# Misc
GEO_CORS_ORIGINS=
GEO_LOG_FORMAT=text
